{
  "name": "CyberSim",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "nodemon --watch src --exec tsx src/server/server.ts",
    "dev:full": "concurrently \"npm run dev:server\" \"vite\"",
    "preview:server": "tsx src/server/server.ts",
    "preview:full": "npm run build && concurrently \"npm run preview:server\" \"vite preview --host\"",
    "build": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "postinstall": "prisma generate",
    "preview": "vite preview --host",
    "start": "node dist/server/server/server.js",
    "start:all": "concurrently \"npm run preview\" \"npm run start\"",
    "lint": "eslint .",
    "test": "vitest",
    "test-concurrencia": "node tests/concurrencia/test-concurrencia-grupos.mjs && node tests/concurrencia/test-concurrencia-progreso.mjs",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "render-build": "npm install --include=dev && npx prisma generate && npx prisma migrate deploy && npm run build:server",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup:docker": "npm run docker:up && timeout 5 && npm run db:migrate"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@qdrant/js-client-rest": "1.18.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@solar-icons/react": "^1.1.0",
    "@supabase/supabase-js": "^2.86.0",
    "@types/three": "^0.180.0",
    "@xyflow/react": "^12.9.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.23.24",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "magicast": "^0.3.5",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "prisma": "^7.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.4",
    "resend": "^6.8.0",
    "three": "^0.180.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.50.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^4.0.2"
  }
}
