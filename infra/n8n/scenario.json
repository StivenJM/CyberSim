        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {permit:$('Initialize').first().json.permit,messages:$('State 1').first().json.messages,childId:'model-1',tools:[{\"type\":\"function\",\"name\":\"buscar_topologias\",\"description\":\"buscar_topologias en el catálogo autorizado\",\"strict\":true,\"parameters\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"],\"additionalProperties\":false}},{\"type\":\"function\",\"name\":\"buscar_desafios\",\"description\":\"buscar_desafios en el catálogo autorizado\",\"strict\":true,\"parameters\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"],\"additionalProperties\":false}},{\"type\":\"function\",\"name\":\"buscar_conocimiento\",\"description\":\"buscar_conocimiento en el catálogo autorizado\",\"strict\":true,\"parameters\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"],\"additionalProperties\":false}},{\"type\":\"function\",\"name\":\"buscar_contexto\",\"description\":\"buscar_contexto en el catálogo autorizado\",\"strict\":true,\"parameters\":{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"],\"additionalProperties\":false}}]} }}",
        "options": {
          "timeout": 300000
        }
      },
