{
  "name": "@cybersim/backend",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "build": "prisma generate && tsc --project tsconfig.json && node scripts/copy-prisma-client.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest --run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@qdrant/js-client-rest": "1.18.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.11",
    "prisma": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^4.0.2"
  }
}
