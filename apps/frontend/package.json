{
	"name": "@cybersim/frontend",
	"private": true,
	"version": "5.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm run typecheck && vite build",
		"preview": "vite preview --host",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.integration.json --noEmit",
		"lint": "biome check . --error-on-warnings",
		"test": "vitest --run",
		"coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"export:rag": "tsx scripts/export-rag-knowledge.ts",
		"lint:fix": "biome check . --write",
		"format": "biome format . --write",
		"format:check": "biome format ."
	},
	"dependencies": {
		"@cybersim/scenario-contract": "workspace:*",
		"@phosphor-icons/react": "^2.1.10",
		"@react-three/drei": "^10.7.6",
		"@react-three/fiber": "^9.4.0",
		"@react-three/postprocessing": "^3.0.4",
		"@solar-icons/react": "^1.1.0",
		"@xyflow/react": "^12.9.2",
		"framer-motion": "^12.23.24",
		"lucide-react": "^0.577.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router": "^7.9.4",
		"three": "^0.180.0",
		"three-stdlib": "2.36.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@playwright/test": "^1.64.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.1.16",
		"@types/react-dom": "^19.1.9",
		"@types/three": "^0.180.0",
		"@vitejs/plugin-react": "^5.0.4",
		"@vitest/coverage-v8": "^4.0.2",
		"tsx": "^4.21.0",
		"typescript": "~5.9.3",
		"vite": "^7.1.7",
		"vitest": "^4.0.2"
	}
}
