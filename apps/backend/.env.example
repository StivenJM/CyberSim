# ===========================================
# DESARROLLO LOCAL CON DOCKER 
# ===========================================
# Usar este archivo cuando corras PostgreSQL en Docker
# Copiar como .env antes de iniciar el servidor
# ===========================================

# Configuración del servidor
PORT=3000
NODE_ENV=development

# Base de datos LOCAL (Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cybersim"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cybersim"

# Autenticación
JWT_SECRET="TIC-SECRET-LOCAL-DEV"
FRONTEND_URL="http://localhost:5173"

# URLs locales
BACKEND_URL="http://localhost:3000"
VITE_BACKEND_URL="http://localhost:3000"

# Integraciones (opcional)
N8N_FEEDBACK_WEBHOOK_URL="http://172.0.0.1:1234/webhook/uid123"

OPENAI_API_KEY=TIC-SECRET-LOCAL-DEV
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
QDRANT_URL=https://identificador.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=TIC-SECRET-LOCAL-DEV
QDRANT_COLLECTION_SECURITY=ciberseguridad
QDRANT_COLLECTION_CONTEXT=ContextoCiberSeguridad
PIPER_TTS_API_URL=http://127.0.0.1:5000
PIPER_TTS_BASE_URL=http://127.0.0.1:5000
QDRANT_HTTPS=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario@gmail.com
SMTP_PASS=app-secret-password
FROM_EMAIL=usuario@gmail.com
