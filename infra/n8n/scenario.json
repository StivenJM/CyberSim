      "parameters": {
        "jsCode": "const r=$json;const calls=(r.data.output||[]).filter(x=>x.type==='function_call');if(calls.length>1)throw new Error('Parallel tools disabled');if(!calls.length)return [{json:{final:true,data:JSON.parse(r.text)}}];const call=calls[0];const types={\"buscar_topologias\":\"topologias\",\"buscar_desafios\":\"desafios\",\"buscar_conocimiento\":\"conocimiento\",\"buscar_contexto\":\"contexto\"};if(!types[call.name])throw new Error('Unknown tool');return [{json:{final:false,call,type:types[call.name],query:JSON.parse(call.arguments).query}}];"
      }
