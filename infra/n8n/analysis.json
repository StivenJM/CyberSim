{
  "name": "CyberSim analysis",
  "nodes": [
    {
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "cybersim-analysis",
      "parameters": {
        "httpMethod": "POST",
        "path": "cybersim-analysis",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cybersim-webhook",
          "name": "cybersim-webhook"
        }
      }
    },
    {
      "id": "Initialize",
      "name": "Initialize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "jsCode": "const b=$json.body;if(!b.permit||b.kind!==\"analysis\")throw new Error('Invalid operation');return [{json:b}];"
      }
    },
    {
      "id": "Attach",
      "name": "Attach",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "retryOnFail": false,
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://backend:3001/internal/v1/operations/' + $('Initialize').first().json.operationId + '/attach' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {permit:$('Initialize').first().json.permit,executionId:$execution.id} }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cybersim-service",
          "name": "cybersim-service"
        }
      }
    },
    {
      "id": "State 1",
      "name": "State 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "jsCode": "const b=$('Initialize').first().json;return [{json:{...b,messages:[{role:'system',content:\"Analiza exclusivamente los agregados del curso. No inventes alumnos ni medidas. Responde en español con cinco secciones, cada una titulo y contenido: resumen_ejecutivo, patrones, fortalezas, areas_mejora, recomendaciones.\"},{role:'user',content:JSON.stringify({payload:b.payload})}]}}];"
      }
    },
    {
      "id": "Model 1",
      "name": "Model 1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        0
      ],
      "retryOnFail": false,
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://backend:3001/internal/v1/operations/' + $('Initialize').first().json.operationId + '/model' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {permit:$('Initialize').first().json.permit,messages:$('State 1').first().json.messages,childId:'model-1',tools:[]} }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cybersim-service",
          "name": "cybersim-service"
        }
      }
    },
    {
      "id": "Extract 1",
      "name": "Extract 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "jsCode": "const r=$json;const calls=(r.data.output||[]).filter(x=>x.type==='function_call');if(calls.length>1)throw new Error('Parallel tools disabled');if(!calls.length)return [{json:{final:true,data:JSON.parse(r.text)}}];const call=calls[0];const types={\"buscar_topologias\":\"topologias\",\"buscar_desafios\":\"desafios\",\"buscar_conocimiento\":\"conocimiento\",\"buscar_contexto\":\"contexto\"};if(!types[call.name])throw new Error('Unknown tool');return [{json:{final:false,call,type:types[call.name],query:JSON.parse(call.arguments).query}}];"
      }
    },
    {
      "id": "Final 1",
      "name": "Final 1",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        300,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.final }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "Limit 1",
      "name": "Limit 1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        220
      ],
      "parameters": {
        "jsCode": "throw new Error('Tool limit reached; no automatic repair');"
      }
    },
    {
      "id": "Respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        900,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {data: $json.data} }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Initialize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Initialize": {
      "main": [
        [
          {
            "node": "Attach",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attach": {
      "main": [
        [
          {
            "node": "State 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "State 1": {
      "main": [
        [
          {
            "node": "Model 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Model 1": {
      "main": [
        [
          {
            "node": "Extract 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract 1": {
      "main": [
        [
          {
            "node": "Final 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Final 1": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Limit 1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveExecutionProgress": false,
    "executionTimeout": 310
  }
}

