{
  "name": "cybersim",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {"node": ">=22.13.0", "pnpm": "12.14.0"},
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "test:e2e": "pnpm --filter @cybersim/frontend run test:e2e",
    "db:generate": "pnpm --filter @cybersim/backend run db:generate"
  },
  "devDependencies": {
    "pg": "^8.16.3"
  }
}
